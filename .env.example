# 이 파일을 .env.local 로 복사해서 사용하세요. (.env.local 은 git에 올라가지 않습니다)

# --- 크롤러 동작 ---

# 동시에 처리할 대상 수 (기본 2). 대상 서버에 부담을 주지 않는 선에서 조정하세요.
CRAWL_CONCURRENCY=2

# 실행(run) 안에서 동시에 크롤할 언론사 수 상한 (기본 3). 언론사 1곳당 동시 페이지 수가 아니라,
# 이 프로세스가 동시에 여는 Playwright 페이지 총량(언론사 수 x CRAWL_CONCURRENCY)이 무한정
# 커지지 않도록 로컬 리소스를 보호하는 값입니다.
CRAWL_PRESS_CONCURRENCY=3

# 페이지 단위 타임아웃 (ms, 기본 30000)
CRAWL_TIMEOUT_MS=30000

# 각 요청 사이 최소 지연 (ms, 기본 500). 0으로 두지 않는 것을 권장합니다.
CRAWL_DELAY_MS=500

# 요청에 사용할 User-Agent. 비워 두면 기본 데스크톱 Chrome UA를 사용합니다.
# CRAWL_USER_AGENT=

# --- Playwright ---

# 비워 두면 Playwright 번들 Chromium(headless shell)을 사용합니다.
# 시스템에 설치된 Chrome을 쓰려면 chrome 으로 지정하세요.
# PLAYWRIGHT_CHANNEL=chrome

# 디버깅용. false 로 두면 실제 브라우저 창이 뜹니다.
PLAYWRIGHT_HEADLESS=true
